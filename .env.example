# ── Вход ──────────────────────────────────────────────
# Пароль для входа в приложение (смена пароля разлогинивает все устройства)
APP_PASSWORD=change-me
# Секрет для подписи cookie-сессии. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=
# false — только если открываете приложение по http без TLS (иначе cookie не сохранится).
# В проде используйте HTTPS — он нужен и для PWA.
COOKIE_SECURE=true

# ── База данных ───────────────────────────────────────
# Путь к файлу SQLite, общий для web и worker. Относительный путь — от корня проекта.
# В Docker переопределяется на /data/avetrack.db (docker-compose.yml).
DATABASE_PATH=./data/avetrack.db

# ── Telegram ──────────────────────────────────────────
# Токен от @BotFather и id вашего чата (как получить — README, раздел «Telegram-бот»)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Публичный адрес приложения — для кнопки «Открыть AveTrack» в сообщениях бота
# (localhost Telegram не принимает, кнопка тогда просто не показывается)
APP_URL=https://track.example.com

# ── Бэкапы ────────────────────────────────────────────
# Куда складывать копии базы и сколько последних хранить
BACKUP_DIR=./backups
BACKUP_KEEP=14
